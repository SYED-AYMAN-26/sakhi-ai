# Sakhi AI - environment configuration
# Copy this file to ".env.local" and fill in your key.
# The app runs fully WITHOUT a key (determistic demo engine). Add a key to
# switch on Gemini for smarter intent understanding + simpler explanations.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
